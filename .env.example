# Copy to .env and adjust. No spaces around "=" — Docker Compose's env_file
# does not trim them and would read the key as "API_PORT " with value " 8000".

# API
# Required. There is no silent default: a forgotten ENV on a server used to
# select development, including well-known secrets.
ENV=development
API_NAME=Example
API_HOST=127.0.0.1
API_PORT=8000

# Session tokens. Development on loopback fills in a well-known secret when
# this is unset. A process bound to anything else — including Compose's
# 0.0.0.0 — refuses to start without a unique value of at least 32 bytes.
# AUTH_TOKEN_SECRET=

# How long a session token stays valid. A Go duration such as 45m or 12h — a
# bare number is rejected rather than guessed at. Shorter is safer; revoking a
# device already takes effect on the next request, so this only bounds how long
# a token survives a password change.
# AUTH_TOKEN_TTL=1h

# What goes into the token's iss and aud, and what every token is checked
# against. The default names the product, which separates it from a different
# service sharing a secret. Set it per deployment when two installations of THIS
# product share one — staging honouring a production token is otherwise a
# configuration file away.
# AUTH_TOKEN_ISSUER=multi-tenant-go-service

# HMAC pepper for the emailed codes — password resets and two-factor sign-in
# alike. Keep it independent of AUTH_TOKEN_SECRET: rotating session tokens must
# not invalidate codes already sitting in someone's inbox. Same loopback rule
# as AUTH_TOKEN_SECRET.
# AUTH_RESET_SECRET=

# Telemetry. Empty means off, and off means the process behaves exactly as it
# did before it had any — an observability stack the API cannot start without
# would be a new way to take production down.
#
# `task otel` starts a collector on the compose network and Grafana on :3000.
# For a host run, point this at it:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_INSECURE=1
# OTEL_SERVICE_NAME=multi-tenant-go-service
# OTEL_SERVICE_VERSION=dev
# Fraction of traces kept when nothing upstream decided. 1 in development,
# 0.1 in production unless set.
# OTEL_TRACES_SAMPLER_ARG=1

# The process log. console is colour and aligned columns for a person;
# json is for a shipper. Development defaults to console, production to json.
# LOG_FORMAT=console
# LOG_LEVEL=debug
# always keeps colour when the output is a pipe; never drops it on a terminal.
# NO_COLOR (any value) also turns it off.
# LOG_COLOR=auto

# TLS is optional on loopback. Production listening on a non-loopback address
# requires both files, or a reverse proxy terminating TLS in front.
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# SMTP. Required in production. In development, leaving SMTP_HOST empty logs
# that a code was requested (never the code itself) to the process log.
# The code is printed to stderr only when stderr is a TTY, or MAIL_LOG_CODES=1.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# MAIL_LOG_CODES=

# Comma-separated CIDRs (or bare IPs) whose X-Forwarded-For may be believed.
# Empty means never trust a header: the rate limiter and audit log key on the
# TCP peer. Spoofing X-Forwarded-For from an unlisted address cannot mint
# extra buckets. Do not list 0.0.0.0/0.
# TRUSTED_PROXIES=

# Comma-separated browser origins allowed to read this API, as scheme://host[:port]
# with nothing after the host. Empty — the default — answers no cross-origin
# request, which is right when there is no browser client: the header is what
# grants access, so its absence is the refusal. There is no "*" and no pattern
# matching; production additionally refuses http:// for anything but loopback.
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Uploaded files. Ciphertext lands under FILES_STORAGE_PATH/{orgID}/{fileID}
# for tenant documents and FILES_STORAGE_PATH/account/{fileID} for account
# blobs (an avatar today; later, anything that is not a tenant document).
# Development on loopback fills in a well-known encryption key when this is
# unset; a process bound to anything else — including Compose's 0.0.0.0 —
# refuses to start without a unique 32-byte (or 64-hex) value. The in-repo
# default is rejected in production even when set.
# FILES_ENCRYPTION_KEY=
# FILES_STORAGE_PATH=var/files
# FILES_STORAGE_BACKEND=local
# Largest plaintext, also a memory bound. Cap 512 MiB.
# FILES_MAX_BYTES=10485760
# Account photo cap. Separate because a 10 MiB face is not a face.
# FILES_AVATAR_MAX_BYTES=2097152
# Comma-separated canonical media types. Empty uses the product default
# (pdf, png, jpeg, gif, webp, plain, csv, json, zip, docx/xlsx/pptx).
# There is no "*".
# FILES_ALLOWED_TYPES=
# off | optional | required. required refuses the upload when clamd cannot
# be reached. `task compose:clamav` starts clamd on the compose network.
# FILES_SCAN_MODE=off
# FILES_CLAMAV_ADDR=127.0.0.1:3310
# FILES_CLAMAV_TIMEOUT=10s
# Caps POST /v1/orgs/{orgID}/files and POST /v1/me/avatar. 0 disables (tests).
# FILES_UPLOAD_PER_MINUTE=20
# FILES_REQUIRE_DECLARED_MATCH=true
# FILES_REQUIRE_EXTENSION_MATCH=true
# FILES_BLOCK_EXECUTABLES=true

# Postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE_NAME=postgres
POSTGRES_SSL_MODE=disable

# Connection pool. Keep idle equal to open unless you have a reason not to:
# a lower idle count makes the pool reopen connections under steady load.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# --- Docker development environment (.docker/compose.yml) ---------------------
# API_PORT and POSTGRES_PORT above are reused as the *host* side of the
# published mappings. Inside the containers they are overridden: the API
# always listens on 8000 and Postgres on 5432, whatever these say. On the
# host (`task run`) they are the real listen / connect ports.
#
# Change one when something else on your machine already holds the port —
# `lsof -nP -iTCP:8000 -sTCP:LISTEN` says what.
#
# The two below exist only for the optional debug profile:
#
#   docker compose --profile debug up api-debug
#
# API_DEBUG_PORT=4001     # the API running under delve
# DELVE_PORT=2345         # the debugger itself; attach your IDE here
